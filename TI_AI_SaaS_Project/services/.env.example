# Example environment for the standalone AI service layer.
# Copy to services/.env and source before running:
#     set -a; source services/.env; set +a
# Or (PowerShell): Get-Content services/.env | ForEach-Object { ... }

# -------- Django project secrets --------
# Required in production; omit to use the dev-only fallback in DEBUG mode.
AI_SERVICE_SECRET_KEY=change-me-in-production
AI_SERVICE_DEBUG=True
AI_SERVICE_ALLOWED_HOSTS=localhost,127.0.0.1

# Port used by runserver / gunicorn in dev.
AI_SERVICE_PORT=9000

# -------- Background dispatcher --------
# Max number of concurrent LangGraph runs per service process.
# Keep small in dev; scale up on GPU hosts.
AI_SERVICE_MAX_WORKERS=4

# -------- Redis --------
# Used for analysis state (lock, progress, cancellation flag).
# Must match Django's REDIS_URL (including DB index) — see services/config/settings.py
# and x_crewter/settings.py (default redis://localhost:6379/0).
REDIS_URL=redis://localhost:6379/0

# -------- Ollama (local LLM) --------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi4-mini

# -------- API authentication --------
# Comma-separated list of keys; each inbound request must send one
# via the X-API-Key header. Required for all /api/v1/ routes.
API_KEYS=dev-key-change-me

# -------- Outbound webhook (service -> Django) --------
# Must be set together or both empty. When empty, the service still
# runs but does not push progress/completion updates back to Django.
# Must match Django's AI_SERVICE_WEBHOOK_SECRET (see x_crewter/settings.py).
DJANGO_WEBHOOK_URL=http://127.0.0.1:8000/api/analysis/internal/analysis/webhook/
WEBHOOK_SECRET=shared-webhook-secret-change-me
